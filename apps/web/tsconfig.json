{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pcs/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@pcs/db": [
        "../../packages/db/src/index.ts"
      ],
      "@pcs/db/schema": [
        "../../packages/db/src/schema.ts"
      ],
      "@pcs/pack-engine": [
        "../../packages/pack-engine/src/index.ts"
      ],
      "@pcs/economy-engine": [
        "../../packages/economy-engine/src/index.ts"
      ],
      "@pcs/card-data": [
        "../../packages/card-data/src/index.ts"
      ],
      "@pcs/card-data/era": [
        "../../packages/card-data/src/era.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
